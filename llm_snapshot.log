<script>
  (function () {
    function initTrail() {
      const path = window.location.pathname;

      /* ── root detection (works for GitHub Pages subdirectory or bare domain) ── */
      const rootMatch = path.match(/^(.*?\/who-i\/|.*?\/who-reviews\/|.*?\/repos-00\/|\/)/);
      const root = rootMatch ? rootMatch[1] : '/';

      /* ── wire hrefs ── */
      document.querySelectorAll('.trail-dot[data-dest]').forEach(dot => {
        dot.href = root + dot.dataset.dest;
      });

      /* ── detect current level ── */
      const levelMatch = path.match(/level(\d)/);
      const current = levelMatch ? parseInt(levelMatch[1], 10) : 0;

      document.querySelectorAll('.trail-dot').forEach(dot => {
        const lvl = parseInt(dot.dataset.level, 10);
        dot.classList.toggle('active',    lvl === current);
        dot.classList.toggle('completed', lvl < current);
      });

      /* ── light up connecting lines up to (but not including) current ── */
      const lines = document.querySelectorAll('.trail-line');
      lines.forEach((line, i) => {
        /* line[i] connects dot[i] to dot[i+1]; light it if both are completed/current */
        line.classList.toggle('lit', i + 1 < current);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTrail);
    } else {
      initTrail();
    }
  })();
</script>
