      <button class="run-btn" id="run-btn" onclick="analyseResidual()">Diagnose residual bias →</button>
      <div class="output-box" id="output-box">
        <div class="out-header">🌿 ε decomposition — what remains in your error term</div>
        <div class="out-body" id="out-body"></div>
