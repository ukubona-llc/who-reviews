      </div>
      <div class="loop-arrow">→</div>
      <div class="loop-node">
        <div class="loop-sym">L(θ)</div>
        <div class="loop-label">Evidence gap</div>
        <div class="loop-sub">what the search reveals is missing</div>
      </div>
      <div class="loop-arrow">→</div>
      <div class="loop-node">
        <div class="loop-sym">∇L</div>
        <div class="loop-label">Gradient</div>
        <div class="loop-sub">direction and magnitude of error</div>
      </div>
      <div class="loop-arrow">→</div>
